template_contribution:
- name: memory_ram_start
  priority: 0
  value: 536870912
- name: memory_ram_size
  priority: 0
  value: 524288
- name: memory_flash_start
  priority: 0
  value: 134217728
- name: memory_flash_size
  priority: 0
  value: 3268608

configuration:
- name: SL_STACK_SIZE
  value: '2752'
- condition:
  - psa_crypto
  name: SL_PSA_KEY_USER_SLOT_COUNT
  value: '0'
ui_hints:
  highlight:
  - path: config/btconf/gatt_configuration.btconf
  - path: README.md
    focus: true
sdk_extension:
- vendor: silabs
  id: wiseconnect3_sdk
  version: 4.0.2

