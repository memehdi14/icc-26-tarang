# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: Tarang_Core_Pipeline
label: Tarang_Core_Pipeline
description: |
  Tarang clinical IoT wearable firmware pipeline for synchronized ECG, IMU, PPG, DSP, AI, and BLE telemetry work.
category: IoT Challenge 2026
filter:
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Bluetooth
package: bluetooth_le_app
quality: production
readme:
- path: README.md
source:
- path: app.c
- path: tarang_nlms.c
tag:
- hwfilter:device:device_supports_bluetooth
- hwfilter:device:device_series_2
include:
- path: .
  file_list:
  - path: app.h
  - path: tarang_pipeline.h
  - path: tarang_nlms.h
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2025.12.3
toolchain_settings: [
  ]
