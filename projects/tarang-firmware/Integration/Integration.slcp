define:
- name: DEBUG_EFM
config_file:
- path: config/tflite/gate_int8.tflite
  directory: tflite
- path: config/tflite/sv_int8.tflite
  directory: tflite
- path: config/tflite/gate.mlconf
  override:
    component: ml_model
    instance: gate
    file_id: ml_compiler_config
  directory: tflite
- path: config/tflite/sv.mlconf
  override:
    component: ml_model
    instance: sv
    file_id: ml_compiler_config
  directory: tflite
template_contribution:
- name: memory_ram_start
  priority: 0
  value: 536870912
- name: memory_ram_size
  priority: 0
  value: 524288
- name: memory_flash_start
  priority: 0
  value: 134217728
- name: memory_flash_size
  priority: 0
  value: 3276800
ui_hints:
  highlight:
  - path: readme.md
    focus: true
sdk_extension:
- vendor: silabs
  id: aiml
  version: 3.0.1
- vendor: silabs
  id: wiseconnect3_sdk
  version: 4.1.1

