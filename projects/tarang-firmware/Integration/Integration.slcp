# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: Integration
label: Integration
description: |
  This example project shows an empty configuration that can be used as a starting point to add components and functionality.
category: Example|Platform
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Project Difficulty
  value:
  - Beginner
package: platform
quality: production
readme:
- path: readme.md
source:
- path: app.c
- path: tarang_ecg.c
- path: tarang_ppg.c
- path: tarang_imu.c
- path: tarang_dsp.c
- path: tarang_pipeline.c
- path: tarang_clinical_engine.c
- path: tarang_ai.cc
- path: tarang_fault_handler.c
- path: gate_model_data.cc
- path: sv_model_data.cc
- path: test_ml_model_multi_input.cc
include:
