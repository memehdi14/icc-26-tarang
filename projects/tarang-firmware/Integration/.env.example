# TARANG Validation & Volunteer Logging Configuration
# =======================================================
# 1. Copy this file to '.env' in this directory.
# 2. Fill in the Airtable API credentials sent by your team lead.

# Airtable API Key or Personal Access Token (PAT)
AIRTABLE_API_KEY=pat_your_airtable_pat_here

# Airtable Base ID (starts with 'app...')
AIRTABLE_BASE_ID=app_your_base_id_here

# Airtable Table Name
AIRTABLE_TABLE_NAME=Volunteers
