<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--Custom BLE GATT-->
<gatt gatt_caching="false" generic_attribute_service="true" header="gatt_db.h" name="Custom BLE GATT" out="gatt_db.c" prefix="gattdb_">

  <!--Generic Access-->
  <service advertise="false" name="Generic Access" requirement="mandatory" sourceId="org.bluetooth.service.generic_access" type="primary" uuid="1800">
    <informativeText>Generic Access Service</informativeText>

    <!--Device Name-->
    <characteristic const="false" id="device_name" name="Device Name" sourceId="org.bluetooth.characteristic.gap.device_name" uuid="2A00">
      <value length="16" type="utf-8" variable_length="true">TARANG</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
        <write authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--Appearance-->
    <characteristic const="true" name="Appearance" sourceId="org.bluetooth.characteristic.gap.appearance" uuid="2A01">
      <value length="2" type="hex" variable_length="false">0000</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>
  </service>

  <!--Device Information-->
  <service advertise="false" id="device_information" name="Device Information" requirement="mandatory" sourceId="org.bluetooth.service.device_information" type="primary" uuid="180A">
    <informativeText>Device Information Service</informativeText>

    <!--Manufacturer Name String-->
    <characteristic const="true" id="manufacturer_name_string" name="Manufacturer Name String" sourceId="org.bluetooth.characteristic.manufacturer_name_string" uuid="2A29">
      <value length="12" type="utf-8" variable_length="false">Silicon Labs</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--System ID-->
    <characteristic const="false" id="system_id" name="System ID" sourceId="org.bluetooth.characteristic.system_id" uuid="2A23">
      <value length="8" type="hex" variable_length="false"/>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>
  </service>

  <!--Vitals Service-->
  <service advertise="false" id="service_vitals" name="Vitals Service" requirement="mandatory" sourceId="" type="primary" uuid="544e937a-82f3-4395-b62b-b72bdea94c75">
    <informativeText>Service A: Periodic vitals sync (HR, SpO2, Timestamp)</informativeText>

    <!--Heart Rate-->
    <characteristic const="false" id="vitals_heart_rate" name="Heart Rate" sourceId="" uuid="b4cf8877-ba1a-414c-a99d-de85a13fd66a">
      <value length="2" type="hex" variable_length="false">4B00</value>
      <properties>
        <read authenticated="false" bonded="true" encrypted="true"/>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--SpO2-->
    <characteristic const="false" id="vitals_spo2" name="SpO2" sourceId="" uuid="b4cf8877-ba1a-414c-a99d-de85a13fd66b">
      <value length="1" type="hex" variable_length="false">62</value>
      <properties>
        <read authenticated="false" bonded="true" encrypted="true"/>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--Vitals Timestamp-->
    <characteristic const="false" id="vitals_timestamp" name="Vitals Timestamp" sourceId="" uuid="b4cf8877-ba1a-414c-a99d-de85a13fd66c">
      <value length="4" type="hex" variable_length="false">00000000</value>
      <properties>
        <read authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>
  </service>

  <!--Analytics Service-->
  <service advertise="false" id="service_analytics" name="Analytics Service" requirement="mandatory" sourceId="" type="primary" uuid="655f937a-82f3-4395-b62b-b72bdea94c75">
    <informativeText>Service B: 5-min analytics rollups (Burden, HRV, Edge AI Health)</informativeText>

    <!--PVC Burden-->
    <characteristic const="false" id="analytics_pvc_burden" name="PVC Burden" sourceId="" uuid="c5da9988-ca2b-425d-b00e-ef96b24ee77b">
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--PAC Burden-->
    <characteristic const="false" id="analytics_pac_burden" name="PAC Burden" sourceId="" uuid="c5da9988-ca2b-425d-b00e-ef96b24ee77c">
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--SDNN-->
    <characteristic const="false" id="analytics_sdnn" name="SDNN" sourceId="" uuid="c5da9988-ca2b-425d-b00e-ef96b24ee77d">
      <value length="2" type="hex" variable_length="false">0000</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--RMSSD-->
    <characteristic const="false" id="analytics_rmssd" name="RMSSD" sourceId="" uuid="c5da9988-ca2b-425d-b00e-ef96b24ee77e">
      <value length="2" type="hex" variable_length="false">0000</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--pRR50-->
    <characteristic const="false" id="analytics_prr50" name="pRR50" sourceId="" uuid="c5da9988-ca2b-425d-b00e-ef96b24ee77f">
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--AI Duty Cycle-->
    <characteristic const="false" id="analytics_ai_duty_cycle" name="AI Duty Cycle" sourceId="" uuid="c5da9988-ca2b-425d-b00e-ef96b24ee780">
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--EM2 Sleep-->
    <characteristic const="false" id="analytics_em2_sleep" name="EM2 Sleep" sourceId="" uuid="c5da9988-ca2b-425d-b00e-ef96b24ee781">
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>
  </service>

  <!--Clinical Event Service-->
  <service advertise="false" id="service_clinical_event" name="Clinical Event Service" requirement="mandatory" sourceId="" type="primary" uuid="7660937a-82f3-4395-b62b-b72bdea94c75">
    <informativeText>Service C: Event-driven anomaly push (Rhythm status, snippet chunks, annotations, ticker)</informativeText>

    <!--Rhythm Status-->
    <characteristic const="false" id="event_rhythm_status" name="Rhythm Status" sourceId="" uuid="d6ebaa99-da3c-536e-c11f-f0a7c35ff88a">
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--Event Meta-->
    <characteristic const="false" id="event_meta" name="Event Meta" sourceId="" uuid="d6ebaa99-da3c-536e-c11f-f0a7c35ff88b">
      <value length="8" type="hex" variable_length="false">0000000000000000</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--ECG Snippet Chunk-->
    <characteristic const="false" id="event_ecg_chunk" name="ECG Snippet Chunk" sourceId="" uuid="d6ebaa99-da3c-536e-c11f-f0a7c35ff88c">
      <value length="244" type="hex" variable_length="true">00</value>
      <properties>
        <indicate authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--ECG Snippet Control-->
    <characteristic const="false" id="event_ecg_control" name="ECG Snippet Control" sourceId="" uuid="d6ebaa99-da3c-536e-c11f-f0a7c35ff88d">
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <write authenticated="false" bonded="true" encrypted="true"/>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--Beat Annotations-->
    <characteristic const="false" id="event_beat_annotations" name="Beat Annotations" sourceId="" uuid="d6ebaa99-da3c-536e-c11f-f0a7c35ff88e">
      <value length="244" type="hex" variable_length="true">00</value>
      <properties>
        <indicate authenticated="false" bonded="true" encrypted="true"/>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>

    <!--Glitch Ticker Event-->
    <characteristic const="false" id="event_glitch_ticker" name="Glitch Ticker Event" sourceId="" uuid="d6ebaa99-da3c-536e-c11f-f0a7c35ff88f">
      <value length="6" type="hex" variable_length="false">000000000000</value>
      <properties>
        <notify authenticated="false" bonded="true" encrypted="true"/>
      </properties>
    </characteristic>
  </service>
</gatt>
