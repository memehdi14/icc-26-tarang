# Copy to tarang.env and update for the Raspberry Pi deployment.
TARANG_BACKEND_URL=http://127.0.0.1:8000
TARANG_BLE_ADDRESS=64:02:8F:64:26:14
TARANG_BLE_NAME_PREFIX=TARANG
TARANG_BLE_PAIR=true
TARANG_BLE_SCAN_TIMEOUT=10
TARANG_BLE_CONNECT_TIMEOUT=35
TARANG_BLE_RECONNECT_DELAY=5
TARANG_DIAGNOSTICS_INTERVAL=10
TARANG_DEVICE_ID=tarang-efr32-demo
TARANG_SESSION_ID=
TARANG_CORS_ORIGINS=*
TARANG_FRONTEND_MODE=production
TARANG_LOG_LEVEL=INFO
