# Standard Template Ignore Rules
*.launch
*.orig
*.bak
**/GNU ARM v*
**/IAR ARM*
**/.projectlinkstore
**/.settings
**/.makefile
**/.trash
**/.uceditor
**/autogen/*.crc
**/sonar-bw/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env
*.egg-info/

# Jupyter
.ipynb_checkpoints/


# Raw dataset (too large for git)
dataset/

# Silicon Labs SDK (installed separately, not committed)
**/simplicity_sdk_*/
**/.projectchecksums
**/.projectlinkstore
**/vscode.conf

# Simplicity Studio Generated Configs and Output
**/autogen/
**/cmake_gcc/
**/config/
**/*.pintool


# Build and Target Output
build/
out/
generated/
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.axf
*.lst
*.d
*.out
GNU ARM*/
IAR*/

# IDE and Environment
.vscode/
.idea/
*.code-workspace

# OS junk
Thumbs.db
.DS_Store
desktop.ini
ehthumbs.db
~$*

# Documentation & Internal Markdowns
# Ignore all internal docs, KBs, guides, reports, and extra markdowns
docs/*
!docs/architecture/

# Ignore internal ML markdowns and summary texts in projects
projects/tarang-ml/*.md
projects/tarang-ml/*.txt

# ML outputs (model binaries and plots regenerated by notebook)
projects/tarang-ml/outputs/
projects/tarang-ml/outputs_v*/
projects/tarang-ml/artifacts/
projects/tarang-ml/metrics/

# Internal Communications, Situation Reports & Team Syncs
agent_guidelines/
*meeting_notes/
*meeting-notes/
*situation_reports/
*status_reports/
*standups/
*chat_logs/
*slack/
notes/
comms/
communications/
*credentials*
*secrets*


